NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://branchpilot:branchpilot@localhost:5432/branchpilot

# Local PostgreSQL Compose credentials. .env is never committed.
POSTGRES_DB=branchpilot
POSTGRES_USER=branchpilot
POSTGRES_PASSWORD=branchpilot

# Protects encrypted OAuth tokens. Use a base64-encoded 32-byte value.
TOKEN_ENCRYPTION_KEY_BASE64=

# BranchPilot's OAuth application registration at Supabase.
SUPABASE_MANAGEMENT_OAUTH_CLIENT_ID=
SUPABASE_MANAGEMENT_OAUTH_CLIENT_SECRET=
SUPABASE_MANAGEMENT_OAUTH_REDIRECT_URI=http://localhost:3000/v1/integrations/supabase/callback
# Override only for deterministic local tests/stubs.
SUPABASE_MANAGEMENT_API_BASE_URL=https://api.supabase.com

# Used by @supabase/server to authenticate BranchPilot callers. Keep the secret key
# server-side only; the adapter uses it to construct its admin client.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Set SUPABASE_JWKS instead of SUPABASE_JWKS_URL for an inline local JWK set.
SUPABASE_JWKS=

# Public browser origins only; comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
